{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Needs the "Bun for Visual Studio Code" extension (oven.bun-vscode)
            "type": "bun",
            "request": "launch",
            "name": "Twitch bot only",
            "program": "${workspaceFolder}/src/bot/twitch/index.ts",
            "cwd": "${workspaceFolder}", // Bun loads .env from here, and ./data/ paths are relative to it
            "env": {
                "NODE_ENV": "development",
                "LOG_LEVEL": "debug"
            },
            "stopOnEntry": false,
            "internalConsoleOptions": "neverOpen"
        }
    ]
}