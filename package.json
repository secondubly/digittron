{
  "name": "digittron",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "bot": "bun run --hot src/bot/twitch/index.ts",
    "dev": "concurrently -n bot,overlay -c magenta,yellow \"bun run bot\" \"bun run web\"",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "server": "bun --hot src/web/index.ts",
    "web": "vite",
    "start": "bun run src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tabler/icons": "^3.49.0",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/easy-bot": "^8.2.0",
    "@twurple/eventsub-base": "^8.2.0",
    "@twurple/eventsub-ngrok": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "igdb-api-types": "^0.2.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
