{
  "name": "digittron",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.ts",
    "bot": "bun run --hot src/bot/twitch/index.ts",
    "dev": "concurrently -n bot,overlay -c purple,orange \"bun run bot\" \"bun run web\"",
    "format": "prettier --write .",
    "server": "bun --hot src/web/index.ts",
    "web": "vite",
    "web:build": "vite build",
    "start": "bun run src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/easy-bot": "^8.2.0",
    "@twurple/eventsub-base": "^8.2.0",
    "@twurple/eventsub-http": "^8.2.0",
    "@twurple/eventsub-ngrok": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
